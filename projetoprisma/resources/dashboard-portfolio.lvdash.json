{
  "datasets": [
    {
      "name": "ds_carteira",
      "displayName": "Carteira em andamento",
      "queryLines": [
        "SELECT projeto_id, projeto, cliente, segmento, ferramenta, gerente_projeto,\n",
        "       valor_contrato, orcamento, pv, ev, ac, eac, spi, cpi, estouro_previsto,\n",
        "       situacao, farol_do_gerente, farol_calculado,\n",
        "       CASE WHEN melancia THEN 'sim' ELSE '' END AS melancia,\n",
        "       CASE WHEN melancia THEN 1 ELSE 0 END AS e_melancia,\n",
        "       CASE WHEN situacao IN ('atenção', 'crítico') THEN 1 ELSE 0 END AS em_risco,\n",
        "       CASE WHEN situacao = 'crítico' THEN 1 ELSE 0 END AS e_critico\n",
        "FROM projeto_situacao_atual\n",
        "WHERE status = 'em_andamento'\n",
        "ORDER BY estouro_previsto DESC\n"
      ],
      "columns": [
        {
          "displayName": "SPI da carteira",
          "expression": "SUM(`ev`) / SUM(`pv`)"
        },
        {
          "displayName": "CPI da carteira",
          "expression": "SUM(`ev`) / SUM(`ac`)"
        }
      ]
    },
    {
      "name": "ds_semanal",
      "displayName": "SPI e CPI semanais da carteira",
      "queryLines": [
        "SELECT semana,\n",
        "       try_divide(SUM(ev), SUM(pv)) AS spi,\n",
        "       try_divide(SUM(ev), SUM(ac)) AS cpi\n",
        "FROM fato_projeto_semana\n",
        "WHERE semana >= DATE'2025-03-07'\n",
        "GROUP BY semana\n",
        "ORDER BY semana\n"
      ]
    },
    {
      "name": "ds_top_ociosos",
      "displayName": "Top 15 custo da hora parada",
      "queryLines": [
        "SELECT concat(nome, ' (', papel, ')') AS pessoa,\n",
        "       SUM(custo_ocioso) AS custo_ocioso,\n",
        "       SUM(horas_ociosas) AS horas_ociosas\n",
        "FROM utilizacao_pessoa_semana\n",
        "WHERE semana > DATE'2026-07-24'\n",
        "GROUP BY nome, papel\n",
        "ORDER BY custo_ocioso DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "ds_utilizacao",
      "displayName": "Utilização por pessoa e projeto",
      "queryLines": [
        "SELECT colaborador_id, nome, papel, senioridade, projeto_id,\n",
        "       SUM(horas_disponiveis) AS horas_disponiveis,\n",
        "       SUM(horas_apontadas) AS horas_apontadas,\n",
        "       SUM(horas_ociosas) AS horas_ociosas,\n",
        "       try_divide(SUM(horas_apontadas), SUM(horas_disponiveis)) AS utilizacao,\n",
        "       SUM(custo_ocioso) AS custo_ocioso\n",
        "FROM utilizacao_pessoa_semana\n",
        "WHERE semana > DATE'2026-07-24'\n",
        "GROUP BY colaborador_id, nome, papel, senioridade, projeto_id\n",
        "ORDER BY utilizacao ASC\n"
      ]
    },
    {
      "name": "ds_causas",
      "displayName": "Causas de bloqueio (90 dias)",
      "queryLines": [
        "SELECT projeto_id, causa_bloqueio, COUNT(*) AS status\n",
        "FROM status_estruturado\n",
        "WHERE data_status >= DATE'2026-07-18'\n",
        "  AND causa_bloqueio NOT IN ('sem_bloqueio', 'nao_reportado')\n",
        "GROUP BY projeto_id, causa_bloqueio\n",
        "ORDER BY projeto_id\n"
      ]
    },
    {
      "name": "ds_fornecedores",
      "displayName": "Fornecedores",
      "queryLines": [
        "SELECT fornecedor,\n",
        "       COUNT(DISTINCT fornecedor_como_veio) AS grafias,\n",
        "       COUNT(*) AS entregas,\n",
        "       try_divide(SUM(prazo_real_dias), SUM(CASE WHEN NOT em_aberto THEN prazo_prometido_dias END)) AS prazo_real_sobre_prometido,\n",
        "       try_divide(COUNT_IF(NOT em_aberto AND dias_de_atraso_na_entrega <= 0), COUNT_IF(NOT em_aberto)) AS pct_no_prazo,\n",
        "       COUNT_IF(em_atraso) AS em_atraso_hoje\n",
        "FROM projetoprisma.silver.entregas_fornecedor\n",
        "GROUP BY fornecedor\n",
        "ORDER BY em_atraso_hoje DESC, prazo_real_sobre_prometido DESC\n"
      ]
    },
    {
      "name": "ds_atrasadas",
      "displayName": "Entregas em atraso hoje",
      "queryLines": [
        "SELECT entrega_id, projeto_id, fornecedor, item, valor, data_pedido, data_prometida,\n",
        "       datediff(DATE'2026-10-16', data_prometida) AS dias_em_atraso\n",
        "FROM projetoprisma.silver.entregas_fornecedor\n",
        "WHERE em_atraso\n",
        "ORDER BY dias_em_atraso DESC\n"
      ]
    }
  ],
